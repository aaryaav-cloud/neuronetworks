# Postgres connection string (Neon works: copy the whole string, including ?sslmode=require)
DATABASE_URL= postgresql://neondb_owner:npg_ATMgSG1PV3xm@ep-crimson-scene-b43rneoa-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# Where the frontend runs. Used for CORS and for the link in password-reset emails.
FRONTEND_URL=http://localhost:5173

# Resend (https://resend.com) for password-reset emails.
# Leave RESEND_API_KEY empty in development: the reset link is printed in the terminal instead.
RESEND_API_KEY=
EMAIL_FROM=NeuroNetworks <onboarding@resend.dev>

PORT=4000
